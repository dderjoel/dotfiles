#!/bin/bash

wifi=$(nmcli --get-values IN-USE,SIGNAL,SSID device wifi 2>/dev/null |
    awk -F':' '$1 == "*" { print $2 "|" $3; exit }')

if [ -n "$wifi" ]; then
    signal=${wifi%%|*}
    ssid=${wifi#*|}

    printf '%s%% %s\n' "$signal" "$ssid" #full text
    printf '%s%%\n' "$signal" #short text

     # Choose contrasting foreground/background colors.
    if [ "$signal" -ge 70 ]; then
        foreground="#ffffff"
        background="#267326"   # dark green
    elif [ "$signal" -ge 40 ]; then
        foreground="#000000"
        background="#e6b800"   # yellow/gold
    else
        foreground="#ffffff"
        background="#b30000"   # dark red
    fi
    printf '%s\n%s\n' "${foreground}" "${background}"
else
    printf '--\n'
fi

